---
/**
 * Lab shell: one experiment per screen. ← / → (and horizontal swipe) go to
 * the previous / next route with a full page load, so each section's
 * framework and animations are torn down on leave. The section number lives
 * in the URL (/1, /2, ...) so a reload stays put.
 */
import '../styles/tokens.css';
import '../styles/shell.css';
import { sections } from '../registry';
import { LANDING_PARTS } from '../landing';

interface Props {
  index: number; // 1-based
}

const { index } = Astro.props;
const total = sections.length;
const section = sections[index - 1];
const pad = (n: number) => String(n).padStart(2, '0');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prev = `${base}/${index === 1 ? total : index - 1}`;
const next = `${base}/${index === total ? 1 : index + 1}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pad(index)} {section.title} · Frontend Lab</title>
    <link rel="prefetch" href={prev} />
    <link rel="prefetch" href={next} />
  </head>
  <body>
    <main class="lab-stage" data-section={section.id} data-lab-part={section.part}>
      <slot />
    </main>

    <nav class="lab-label" aria-label="Lab navigation">
      <ol class="lab-outline" aria-label="Landing page sections">
        {LANDING_PARTS.map((name) => <li>{name}</li>)}
      </ol>
      <a href={prev} aria-label="Previous section" class="lab-arrow">←</a>
      <span class="lab-count">{pad(index)} / {pad(total)}</span>
      <span class="lab-title">{section.title}</span>
      <span class="lab-part" hidden>
        <span class="lab-part-reel" aria-hidden="true"></span>
      </span>
      <span class="lab-meta">{section.stack} · {section.animation}</span>
      {section.figma && <a href={section.figma} class="lab-figma" target="_blank" rel="noopener">Figma</a>}
      <a href={next} aria-label="Next section" class="lab-arrow">→</a>
    </nav>

    <script is:inline define:vars={{ prev, next }}>
      const isTyping = (el) =>
        el instanceof HTMLElement &&
        (el.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(el.tagName));

      document.addEventListener('keydown', (e) => {
        if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
        if (isTyping(document.activeElement)) return;
        if (e.key === 'ArrowLeft') location.assign(prev);
        if (e.key === 'ArrowRight') location.assign(next);
      });

      // Horizontal swipe. Sections that need horizontal drags of their own
      // can opt out by putting data-lab-noswipe on the element.
      let start = null;
      document.addEventListener('touchstart', (e) => {
        const t = e.touches[0];
        start = e.target.closest?.('[data-lab-noswipe]') ? null : { x: t.clientX, y: t.clientY };
      }, { passive: true });
      document.addEventListener('touchend', (e) => {
        if (!start) return;
        const t = e.changedTouches[0];
        const dx = t.clientX - start.x;
        const dy = t.clientY - start.y;
        start = null;
        if (Math.abs(dx) < 60 || Math.abs(dx) < Math.abs(dy) * 1.5) return;
        location.assign(dx > 0 ? prev : next);
      }, { passive: true });

      // Section tag: names the landing page section on screen. The names sit
      // in a one-line reel that moves with the scroll, so as the next section
      // pushes the current one off the top of the viewport, its name pushes
      // the current name out of the tag by the same fraction.
      const stage = document.querySelector('.lab-stage');
      const tag = document.querySelector('.lab-part');
      const reel = tag.querySelector('.lab-part-reel');
      // Outline: every landing section's name. The one on screen is lit, and
      // while one section pushes out another the light is split between them.
      const outline = [...document.querySelectorAll('.lab-outline li')];
      const outlineNames = outline.map((li) => li.textContent);
      let parts = [];
      let scroller = null;
      let frame = 0;

      const scrollerOf = (el) => {
        for (let n = el.parentElement; n && n !== document.body; n = n.parentElement) {
          const { overflowY } = getComputedStyle(n);
          if ((overflowY === 'auto' || overflowY === 'scroll') && n.scrollHeight > n.clientHeight) return n;
        }
        return null;
      };

      const scan = () => {
        const marked = [...stage.querySelectorAll('[data-lab-part]')];
        const next = marked.length ? marked : stage.dataset.labPart ? [stage] : [];
        const names = next.map((el) => el.dataset.labPart);
        if (names.join('\n') !== parts.map((el) => el.dataset.labPart).join('\n')) {
          reel.replaceChildren(...names.map((name) => Object.assign(document.createElement('span'), { textContent: name })));
        }
        parts = next;
        scroller = parts.length > 1 ? scrollerOf(parts[0]) : null;
        tag.hidden = parts.length === 0;
        update();
      };

      // Position in the list: 2.5 means the third section is half pushed out
      // and the fourth fills the other half of the viewport. A section moves
      // out as its top travels from the viewport top to the next section's
      // top. Sections that never reach the top (the last screen of the page)
      // share the remaining scroll evenly, so the tag still ends on the last.
      const position = () => {
        if (!scroller || parts.length < 2) return 0;
        const s = scroller.scrollTop;
        const max = scroller.scrollHeight - scroller.clientHeight;
        const origin = scroller.getBoundingClientRect().top - s;
        const at = parts.map((el) => el.getBoundingClientRect().top - origin);
        const last = at.length - 1;
        const tail = at.findIndex((t) => t > max);
        if (tail > 0) {
          const from = at[tail - 1];
          for (let i = tail; i <= last; i++) at[i] = from + ((max - from) * (i - tail + 1)) / (last - tail + 1);
        }
        if (s <= at[0]) return 0;
        for (let i = 0; i < last; i++) {
          if (s < at[i + 1]) return i + (s - at[i]) / (at[i + 1] - at[i] || 1);
        }
        return last;
      };

      function update() {
        frame = 0;
        const p = position();
        reel.style.setProperty('--lab-part-at', String(p));
        tag.setAttribute('aria-label', `Section: ${parts[Math.round(p)]?.dataset.labPart ?? ''}`);

        // Map the position among this page's parts onto the full outline,
        // so a page that holds only some sections still lights the right ones.
        const indexOf = (i) => outlineNames.indexOf(parts[i]?.dataset.labPart);
        const lo = indexOf(Math.floor(p));
        const hi = indexOf(Math.ceil(p));
        const at = lo < 0 || hi < 0 ? null : lo + (hi - lo) * (p - Math.floor(p));
        outline.forEach((li, i) => {
          const lit = at === null ? 0 : Math.max(0, 1 - Math.abs(at - i));
          li.style.setProperty('--lit', String(lit));
          if (at !== null && Math.round(at) === i) li.setAttribute('aria-current', 'true');
          else li.removeAttribute('aria-current');
        });
      }
      const schedule = () => { frame ||= requestAnimationFrame(update); };

      // Scroll events don't bubble, so listen in the capture phase to hear
      // whichever container the section scrolls in.
      document.addEventListener('scroll', schedule, { capture: true, passive: true });
      addEventListener('resize', schedule);
      // Islands that render on the client add their parts after this runs.
      let rescan = 0;
      new MutationObserver(() => {
        clearTimeout(rescan);
        rescan = setTimeout(scan, 50);
      }).observe(stage, { childList: true, subtree: true, attributes: true, attributeFilter: ['data-lab-part'] });
      scan();
    </script>
  </body>
</html>
