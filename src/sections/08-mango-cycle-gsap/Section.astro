---
// Mango cycle: a looping GSAP showcase of the Process illustration, built
// from docs/briefs/process/mango-cycle-brief.md. The stage SVG and its
// constants are generated by scripts/mango-build.py; see notes.md.
import '@fontsource-variable/manrope';
import './mango-cycle.css';
import stage from './stage.svg?raw';

const STEPS = ['Seed', 'Sprout', 'Tree', 'Mango'];
---

<section class="mc" data-sandbox="08-mango-cycle-gsap" data-lab-noswipe>
  <div
    class="mc__frame"
    tabindex="0"
    role="group"
    aria-roledescription="animation"
    aria-label="Mango growth cycle: seed, sprout, tree, mango, and back to the seed. Left and right arrows step, space plays or pauses."
  >
    <Fragment set:html={stage} />
  </div>
  <div class="mc__stepper">
    <button type="button" class="mc__btn" data-mc="play" aria-pressed="true">Pause</button>
    <div class="mc__steps" style="--pos: 0">
      <span class="mc__track" aria-hidden="true">
        <span class="mc__track-fill"></span>
        <span class="mc__focus"></span>
      </span>
      {STEPS.map((name, i) => (
        <button type="button" class="mc__step" aria-current={i === 0 ? 'step' : undefined}>
          <span class="mc__dot" aria-hidden="true"></span>
          <span class="mc__label">{name}</span>
        </button>
      ))}
    </div>
  </div>
  <p class="mc__live" aria-live="polite">Seed</p>
</section>

<script>
  import { mountMangoCycle } from './mango-cycle';

  const root = document.querySelector<HTMLElement>('[data-sandbox="08-mango-cycle-gsap"]');
  if (root) {
    const unmount = mountMangoCycle(root);
    document.addEventListener('astro:before-swap', unmount, { once: true });
  }
</script>
