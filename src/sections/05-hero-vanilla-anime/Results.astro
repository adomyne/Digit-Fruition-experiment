---
// Results (no framework + Anime.js v4). Figma: Results Section 380:171.
// The rows scroll up under a sticky title. When a row is a little below
// the title, its number counts up from 0 (gray, glowing green while it
// counts), then flickers orange with a bump. While it counts, that row's
// icon (%, $, x, euro) rains into the empty space left and right of the
// rows and piles up there; the icons stay playable (drag, throw, bounce,
// glow on impact).
// Once the last number lands, the four rows drop together into the middle
// of the screen and stay there as an overview while the piles stay put.
// The physics is hand-written (resultsPhysics.ts); Anime.js's timer drives
// its clock and its animate() runs the counts. See notes.md.
import './Results.css';
import dollar from './assets/results-icons/dollar.svg?url';
import euro from './assets/results-icons/euro.svg?url';
import percent from './assets/results-icons/percent.svg?url';
import plus from './assets/results-icons/plus.svg?url';
import download from './assets/download.svg?url';

const SHAPES = [dollar, euro, percent, plus];
/** Each result counts from 0 to `to`; `shape` is its icon in SHAPES. */
const METRICS = [
  { prefix: '', to: 56, suffix: '%', label: 'Growth in Monthly Sales', shape: 2 },
  { prefix: '$', to: 30, suffix: 'K', label: 'New Monthly Revenue', shape: 0 },
  { prefix: '', to: 2, suffix: 'X', label: 'Growth in Monthly Revenue', shape: 3 },
  { prefix: '', to: 43, suffix: '%', label: 'Improvement in CTR', shape: 1 },
];
---

<section class="results" data-results>
  <h2 class="results__title"><span>Results That Speak For Themselves</span></h2>

  <div class="results__stage">
    <div class="results__pool" data-lab-part="Results">
      <div class="results__icons" data-shapes={JSON.stringify(SHAPES)} data-lab-noswipe aria-hidden="true"></div>
    </div>

    <div class="results__overlay" data-lab-part="Results">
      <ul class="results__metrics">
        {METRICS.map((m) => (
          <li class="results__metric" data-to={m.to} data-shape={m.shape}>
            <strong class="results__value" aria-label={`${m.prefix}${m.to}${m.suffix}`}>
              <span aria-hidden="true">{m.prefix}<span class="results__count">{m.to}</span>{m.suffix}</span>
            </strong>
            <span class="results__label">{m.label}</span>
          </li>
        ))}
      </ul>
      <!-- Scroll room: the last row reaches the trigger line, then the
           gathered rows stay in view for about a screen. -->
      <div class="results__tail"></div>
    </div>
  </div>

  <div class="results__foot" data-lab-part="Results">
    <p class="results__note">For 5-6 Figure US/EU brands</p>
    <a href="#top" class="results__audit">
      <img src={download} width="17" height="17" alt="" /> Get a Free Audit
    </a>
  </div>
</section>

<script>
  import { animate, createTimer, type JSAnimation } from 'animejs';
  import { ICON, countFor, createBody, step, wake as wakeBody, wakeAll, type Body, type World } from './resultsPhysics';

  /** How long a number counts up (ms); its icons fall over this time. */
  const COUNT = 1800;
  /** Share of each side's height the finished pile fills. */
  const FILL = 0.5;
  /** Gap (px) between a pile and the rows. */
  const GAP = 12;
  /** A row starts counting this far (px) below the title's text line. */
  const TRIGGER_DROP = 160;
  /** The gathered rows' drop into the middle (ms). */
  const GATHER = 900;
  /** Glow lost per second after an impact. */
  const GLOW_FADE = 2.5;
  /** Frames with everything at rest before the clock pauses. */
  const REST_FRAMES = 45;

  const still = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const root = document.querySelector<HTMLElement>('[data-results]')!;
  const scroller = root.closest<HTMLElement>('[data-sandbox]')!;
  const layer = root.querySelector<HTMLElement>('.results__icons')!;
  const titleText = root.querySelector<HTMLElement>('.results__title > span')!;
  const list = root.querySelector<HTMLElement>('.results__metrics')!;
  const rows = [...root.querySelectorAll<HTMLElement>('.results__metric')];
  const shapes: string[] = JSON.parse(layer.dataset.shapes!);

  // ---------- Two piles, left and right of the rows ----------
  // Each side is its own physics world (walls at its edges), drawn at its
  // offset in the layer, so icons never fall behind the rows.
  interface Side {
    world: World;
    x: number;
    els: HTMLElement[];
    /** What each element shows now, so a frame writes only changes. */
    drawn: boolean[];
    glowing: boolean[];
  }
  const sides: Side[] = [0, 1].map(() => ({ world: { bodies: [], width: 0, height: 0 }, x: 0, els: [], drawn: [], glowing: [] }));

  const measure = () => {
    const l = layer.getBoundingClientRect();
    const c = list.getBoundingClientRect();
    const h = layer.clientHeight;
    const left = Math.max(0, c.left - l.left - GAP);
    const right = Math.max(0, l.right - c.right - GAP);
    sides[0].x = 0;
    sides[1].x = l.width - right;
    sides[0].world.width = left;
    sides[1].world.width = right;
    sides.forEach((s) => (s.world.height = h));
  };

  /** Icons a row drops on each side: together the four rows fill FILL. */
  const perSide = (s: Side) => (s.world.width < ICON * 1.5 ? 0 : Math.max(1, Math.round(countFor(s.world.width, s.world.height, FILL) / rows.length)));

  /** Spawns waiting to fall: when (ms on the clock), where and what. */
  let queue: { at: number; side: Side; shape: number }[] = [];
  let elapsed = 0;
  let resting = 0;
  let running = false;
  let visible = false;

  const addIcon = (s: Side, b: Body) => {
    const el = document.createElement('span');
    // Two oranges at random; the shape is the uploaded SVG as a mask, so
    // the token color shows through it.
    el.className = Math.random() < 0.5 ? 'results__icon' : 'results__icon results__icon--light';
    el.style.setProperty('--shape', `url("${shapes[b.shape]}")`);
    el.append(document.createElement('span'));
    el.firstElementChild!.className = 'results__shape';
    layer.append(el);
    s.world.bodies.push(b);
    s.els.push(el);
  };

  /** A new falling icon above a random spot of the side. The plus starts
   *  turned 45 degrees, so it reads as an x. */
  const spawn = (s: Side, shape: number) => {
    const x = ICON / 2 + Math.random() * Math.max(0, s.world.width - ICON);
    const a = shape === 3 ? Math.PI / 4 : Math.random() * Math.PI * 2;
    addIcon(s, createBody(x, -ICON / 2 - Math.random() * ICON, shape, 300 + Math.random() * 400, (Math.random() - 0.5) * 4, a));
  };

  const render = (dt: number) => {
    for (const s of sides) {
      s.world.bodies.forEach((b, i) => {
        const el = s.els[i];
        if (!b.asleep || !s.drawn[i]) {
          el.style.transform = `translate3d(${s.x + b.x - ICON / 2}px, ${b.y - ICON / 2}px, 0) rotate(${b.a}rad)`;
          s.drawn[i] = b.asleep;
        }
        if (b.glow > 0) {
          b.glow = Math.max(0, b.glow - dt * GLOW_FADE);
          el.style.setProperty('--glow', b.glow.toFixed(3));
        }
        const on = b.glow > 0.01;
        if (on !== !!s.glowing[i]) {
          s.glowing[i] = on;
          el.classList.toggle('is-glowing', on);
        }
      });
    }
  };

  const isResting = () =>
    queue.length === 0 && sides.every((s) => s.world.bodies.every((b) => b.asleep && b.glow === 0));

  const tick = (dt: number) => {
    elapsed += dt * 1000;
    while (queue.length && queue[0].at <= elapsed) {
      const q = queue.shift()!;
      spawn(q.side, q.shape);
    }
    for (const s of sides) if (s.world.bodies.length) step(s.world, dt);
    render(dt);
    // Nothing moving: pause the clock until a count, a pointer or a resize wakes it.
    resting = isResting() ? resting + 1 : 0;
    if (resting > REST_FRAMES) sleep();
  };

  // Anime.js's timer is the physics clock: one tick per frame, paused
  // while the pool is off screen or at rest.
  const clock = createTimer({
    autoplay: false,
    onUpdate: (t) => tick(Math.min(t.deltaTime, 50) / 1000),
  });
  const wake = () => {
    resting = 0;
    if (!running && visible) {
      running = true;
      clock.resume();
    }
  };
  const sleep = () => {
    if (!running) return;
    running = false;
    clock.pause();
  };

  /** A row's icons, spread over the count on both sides. */
  const rain = (shape: number) => {
    measure();
    for (const s of sides) {
      const n = perSide(s);
      for (let i = 0; i < n; i++) queue.push({ at: elapsed + (i / n) * COUNT * 0.9 + Math.random() * 60, side: s, shape });
    }
    queue.sort((a, b) => a.at - b.at);
    wake();
  };

  /** Reduced motion: a row's icons are settled off screen and appear at rest. */
  const settle = (shape: number) => {
    measure();
    for (const s of sides) {
      const n = perSide(s);
      const perRow = Math.max(1, Math.floor(s.world.width / ICON));
      const base = s.world.bodies.length;
      for (let i = 0; i < n; i++) {
        const k = base + i;
        const row = Math.floor(k / perRow);
        const x = ICON / 2 + (k % perRow) * ICON + (row % 2) * (ICON / 2);
        const b = createBody(Math.min(x, s.world.width - ICON / 2), s.world.height - ICON / 2 - row * ICON, shape);
        b.inside = true;
        addIcon(s, b);
      }
      for (let i = 0; i < 120; i++) step(s.world, 1 / 60);
      s.world.bodies.forEach((b) => (b.glow = 0));
    }
    render(0);
  };

  // ---------- Counting ----------
  const counts: JSAnimation[] = [];

  /** Gray, green glow while counting, then an orange flicker and a bump. */
  const play = (row: HTMLElement) => {
    const value = row.querySelector<HTMLElement>('.results__value')!;
    const out = row.querySelector<HTMLElement>('.results__count')!;
    const to = Number(row.dataset.to);
    const shape = Number(row.dataset.shape);
    if (still()) {
      value.classList.add('is-done');
      if (perSideAny()) settle(shape);
      if (++landed === rows.length) gather();
      return;
    }
    const n = { v: 0 };
    out.textContent = '0';
    value.classList.add('is-counting');
    rain(shape);
    counts.push(
      animate(n, {
        v: to,
        duration: COUNT,
        ease: 'outQuart',
        onUpdate: () => {
          out.textContent = String(Math.round(n.v));
        },
        onComplete: () => {
          out.textContent = String(to);
          value.classList.replace('is-counting', 'is-done');
          if (++landed === rows.length) gather();
          counts.push(
            animate(value, {
              opacity: [1, 0.25, 1, 0.45, 1, 0.7, 1],
              duration: 520,
              ease: 'linear',
            }),
            animate(value, {
              scale: [1, 1.14, 1],
              duration: 520,
              ease: 'outBack(2)',
            }),
          );
        },
      }),
    );
  };
  // ---------- Overview: all four rows drop into the middle ----------
  // The list turns sticky (centred under the title, see Results.css), which
  // moves it down at once; a FLIP animation starts it where it was and lets
  // it fall into place with a bounce.
  let landed = 0;
  const gather = () => {
    const before = list.getBoundingClientRect().top;
    list.classList.add('is-gathered');
    const fall = before - list.getBoundingClientRect().top;
    if (still() || Math.abs(fall) < 1) return;
    counts.push(animate(list, { translateY: [fall, 0], duration: GATHER, ease: 'outBounce' }));
  };

  const perSideAny = () => {
    measure();
    return sides.some((s) => perSide(s) > 0);
  };

  // ---------- Trigger: a row reaches the title ----------
  // Once per page load each. The line is TRIGGER_DROP below the stuck
  // title's text, so a number counts in clear view before it slides under.
  const waiting = new Set(rows);
  // Measured from the top of the screen (where the title sticks), so a row
  // that comes in already near the title waits until it is in place.
  const check = () => {
    if (!waiting.size) return;
    const pad = getComputedStyle(titleText);
    const text = titleText.clientHeight - parseFloat(pad.paddingBottom);
    const line = scroller.getBoundingClientRect().top + text + TRIGGER_DROP;
    for (const row of waiting) {
      if (row.getBoundingClientRect().top <= line) {
        waiting.delete(row);
        play(row);
      }
    }
  };
  let frame = 0;
  const onScroll = () => {
    frame ||= requestAnimationFrame(() => {
      frame = 0;
      check();
    });
  };

  // Rows start at 0, waiting to count (the markup has the final values for
  // no-JS and screen readers).
  if (!still()) rows.forEach((row) => (row.querySelector<HTMLElement>('.results__count')!.textContent = '0'));

  // ---------- Drag and throw ----------
  let grab: { s: Side; b: Body; el: HTMLElement; id: number; dx: number; dy: number } | null = null;

  const local = (e: PointerEvent, s: Side) => {
    const r = layer.getBoundingClientRect();
    return { x: e.clientX - r.left - s.x, y: e.clientY - r.top };
  };
  const clampTo = (s: Side, x: number, y: number) => ({
    x: Math.min(Math.max(x, ICON / 2), s.world.width - ICON / 2),
    y: Math.min(Math.max(y, ICON / 2), s.world.height - ICON / 2),
  });

  const onDown = (e: PointerEvent) => {
    const el = (e.target as Element).closest<HTMLElement>('.results__icon');
    if (!el || grab) return;
    const s = sides.find((side) => side.els.includes(el));
    if (!s) return;
    const b = s.world.bodies[s.els.indexOf(el)];
    const p = local(e, s);
    grab = { s, b, el, id: e.pointerId, dx: b.x - p.x, dy: b.y - p.y };
    b.hold = { x: b.x, y: b.y };
    wakeBody(b);
    b.inside = true;
    el.classList.add('is-held');
    el.setPointerCapture(e.pointerId);
    e.preventDefault();
    wake();
  };
  const onMove = (e: PointerEvent) => {
    if (!grab || e.pointerId !== grab.id) return;
    const p = local(e, grab.s);
    grab.b.hold = clampTo(grab.s, p.x + grab.dx, p.y + grab.dy);
  };
  const onUp = (e: PointerEvent) => {
    if (!grab || e.pointerId !== grab.id) return;
    grab.b.hold = null; // keeps its speed: a throw
    grab.el.classList.remove('is-held');
    grab = null;
    wake();
  };
  const onTouchMove = (e: TouchEvent) => {
    // Dragging an icon never scrolls the page.
    if (grab) e.preventDefault();
  };

  layer.addEventListener('pointerdown', onDown);
  layer.addEventListener('pointermove', onMove);
  layer.addEventListener('pointerup', onUp);
  layer.addEventListener('pointercancel', onUp);
  scroller.addEventListener('scroll', onScroll, { passive: true });
  scroller.addEventListener('touchmove', onTouchMove, { passive: false });

  // The clock runs only while the pool is on screen.
  const io = new IntersectionObserver(([entry]) => {
    visible = entry.isIntersecting;
    if (visible) wake();
    else sleep();
  });
  io.observe(layer);

  const ro = new ResizeObserver(() => {
    measure();
    // A pile wider than its new side is pushed back in by the walls.
    sides.forEach((s) => wakeAll(s.world));
    wake();
    check();
  });
  ro.observe(layer);
  check();

  // Navigation is full page loads today; this is for view transitions.
  document.addEventListener(
    'astro:before-swap',
    () => {
      clock.revert();
      counts.forEach((a) => a.revert());
      cancelAnimationFrame(frame);
      io.disconnect();
      ro.disconnect();
      layer.removeEventListener('pointerdown', onDown);
      layer.removeEventListener('pointermove', onMove);
      layer.removeEventListener('pointerup', onUp);
      layer.removeEventListener('pointercancel', onUp);
      scroller.removeEventListener('scroll', onScroll);
      scroller.removeEventListener('touchmove', onTouchMove);
    },
    { once: true },
  );
</script>
