---
// Ads (no framework + Anime.js v4): "We Handle All Amazon Ads Campaigns",
// five services on a wheel that turns counter-clockwise, one step at a
// time. Figma: Services Section 142:1216, keywords 301:15, arrows 301:24.
// Scrolling down turns the wheel until the fifth step, then the page
// scrolls on; after that first pass the wheel never holds the scroll again
// until a reload. Autoplay as in the Process section (2 s on each step, 1 s
// to turn) until the disc, an arrow or a keyword is clicked. The disc's
// glow moves to a random spot on every turn. See notes.md.
import './Ads.css';
import line from './assets/ads/line.svg?url';
import ring from './assets/ads/number-ring.svg?url';
import arrowPrev from './assets/ads/arrow-prev.svg?url';
import arrowNext from './assets/ads/arrow-next.svg?url';
import { ADS_STEPS } from './adsCopy';
---

<section class="ads" data-ads data-lab-part="Ads">
  <div class="ads__frame">
    <header class="ads__heading">
      <h2 class="ads__title">We Handle All Amazon Ads Campaigns</h2>
      <p class="ads__subtitle">A Clear Plan of Action - Not Just Insights</p>
    </header>

    <!-- The disc (Figma Ellipse 9), inline so its glow can move. The
         gradient starts where Figma has it. -->
    <svg class="ads__arc" viewBox="0 0 1069.72 1069.72" aria-hidden="true">
      <defs>
        <radialGradient
          id="ads-glow"
          cx="0"
          cy="0"
          r="1"
          gradientUnits="userSpaceOnUse"
          gradientTransform="translate(707.784 486.915) rotate(-124.882) scale(642.972 726.586)"
        >
          <stop class="ads__glow-from"></stop>
          <stop class="ads__glow-to" offset="1"></stop>
        </radialGradient>
      </defs>
      <circle class="ads__disc" cx="534.862" cy="534.862" r="534.362" fill="url(#ads-glow)"></circle>
    </svg>

    <ol class="ads__wheel" aria-label="Amazon Ads campaigns">
      {ADS_STEPS.map((s, i) => (
        <li class="ads__step" style={{ '--i': i }} aria-current={i === 0 ? 'step' : undefined}>
          <img class="ads__ring" src={ring} width="83.496" height="83.496" alt="" />
          <p class="ads__number" aria-hidden="true">{i + 1}</p>
          <img class="ads__line" src={line} width="49.333" height="1" alt="" />
          <div class="ads__service">
            <h3 class="ads__service-title">{s.title}</h3>
            <p class="ads__service-body">{s.body}</p>
          </div>
        </li>
      ))}
    </ol>

    <ul class="ads__keywords" aria-label="Go to a campaign">
      {ADS_STEPS.map((s, i) => (
        <li>
          <button type="button" class="ads__keyword" data-text={s.title} aria-current={i === 0 ? 'true' : undefined}>
            {s.title}
          </button>
        </li>
      ))}
    </ul>

    <div class="ads__arrows">
      <button type="button" class="ads__arrow ads__arrow--prev" aria-label="Previous campaign">
        <img src={arrowPrev} width="32" height="32" alt="" />
      </button>
      <button type="button" class="ads__arrow ads__arrow--next" aria-label="Next campaign">
        <img src={arrowNext} width="32" height="32" alt="" />
      </button>
    </div>

    <p class="ads__live" aria-live="polite"></p>
  </div>
</section>

<script>
  import { animate, utils, type JSAnimation } from 'animejs';
  import { ADS_STEPS } from './adsCopy';

  /** Autoplay holds each step this long (ms), as in the Process section. */
  const HOLD = 2000;
  /** One turn of the wheel (ms). */
  const TRAVEL = 1000;
  /** Each extra step on a keyword jump adds this much (ms), so far jumps
   *  pass the steps in between quickly. */
  const EXTRA_STEP = 400;
  /** Degrees between spokes: five steps make a full turn. */
  const SPOKE = 360 / ADS_STEPS.length;
  const COUNT = ADS_STEPS.length;
  /** Scroll (px) that turns the wheel one step: about one mouse-wheel notch. */
  const STEP_DISTANCE = 60;
  /** Input is ignored for this much of a turn, so one flick moves one step. */
  const SETTLE = 0.6;
  const LAST = COUNT - 1;
  /** The glow's random range, in the disc's own units: its centre stays in
   *  the disc's visible upper half; Figma's scale is kept. */
  const GLOW = { x: [260, 810], y: [330, 620], r: [-170, -10] } as const;

  const still = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const root = document.querySelector<HTMLElement>('[data-ads]')!;
  const scroller = root.closest<HTMLElement>('[data-sandbox]')!;
  const wheelEl = root.querySelector<HTMLElement>('.ads__wheel')!;
  const stepEls = [...root.querySelectorAll<HTMLElement>('.ads__step')];
  const keywordEls = [...root.querySelectorAll<HTMLButtonElement>('.ads__keyword')];
  const prevEl = root.querySelector<HTMLButtonElement>('.ads__arrow--prev')!;
  const nextEl = root.querySelector<HTMLButtonElement>('.ads__arrow--next')!;
  const discEl = root.querySelector<SVGCircleElement>('.ads__disc')!;
  const glowEl = root.querySelector<SVGRadialGradientElement>('#ads-glow')!;
  const live = root.querySelector('.ads__live')!;

  /** The wheel's angle in degrees; Anime.js animates it and render() writes it. */
  const wheel = { angle: 0 };
  /** The disc's glow: centre and turn of Figma's radial gradient. */
  const glow = { x: 707.784, y: 486.915, r: -124.882 };
  let step = 0;
  let target = 0; // the angle the wheel is turning to
  let turn: JSAnimation | undefined;
  let turnStart = 0;
  let turnTime = TRAVEL;
  let next = 0;
  let visible = false;
  /** Autoplay runs until the disc, an arrow or a keyword is clicked. */
  let autoplay = true;
  // Scroll hold: `held` while the wheel takes the scroll; `done` once the
  // reader has scrolled past the fifth step (until a reload).
  let held = false;
  let done = false;
  let heldAt = 0;
  let pending = 0;
  let lastOffset = Infinity;
  let touchY = 0;

  // Each spoke is brightest at the top and fades out by the next spoke's place.
  const render = () => {
    wheelEl.style.transform = `rotate(${wheel.angle}deg)`;
    stepEls.forEach((el, i) => {
      const d = ((((i * SPOKE + wheel.angle) % 360) + 540) % 360) - 180;
      el.style.opacity = `${Math.max(0, Math.cos((d * Math.PI) / (2 * SPOKE)))}`;
    });
  };
  const renderGlow = () =>
    glowEl.setAttribute('gradientTransform', `translate(${glow.x} ${glow.y}) rotate(${glow.r}) scale(642.972 726.586)`);

  const scheduleNext = () => {
    window.clearTimeout(next);
    // While the wheel holds the scroll, autoplay stops at the last step so
    // the next scroll carries on down the page.
    if (!autoplay || !visible || (held && step === LAST)) return;
    next = window.setTimeout(() => turnBy(1), HOLD);
  };
  const stopAutoplay = () => {
    autoplay = false;
    window.clearTimeout(next);
  };

  const showStep = (announce: boolean) => {
    stepEls.forEach((el, i) => (i === step ? el.setAttribute('aria-current', 'step') : el.removeAttribute('aria-current')));
    keywordEls.forEach((el, i) => (i === step ? el.setAttribute('aria-current', 'true') : el.removeAttribute('aria-current')));
    if (announce) live.textContent = `${step + 1} of ${COUNT}: ${ADS_STEPS[step].title}`;
  };

  /** Turns the wheel `by` steps: positive is counter-clockwise, to the
   *  next service. */
  function turnBy(by: number, announce = false) {
    window.clearTimeout(next);
    if (!by) return;
    step = (((step + by) % COUNT) + COUNT) % COUNT;
    target -= by * SPOKE;
    showStep(announce);
    turnStart = performance.now();
    turnTime = TRAVEL + (Math.abs(by) - 1) * EXTRA_STEP;

    if (still()) {
      // Reduced motion: a quick cross-fade instead of the turn; the glow
      // stays where it is.
      turn = animate(wheelEl, {
        opacity: 0,
        duration: 150,
        onComplete: () => {
          wheel.angle = target;
          render();
          animate(wheelEl, { opacity: 1, duration: 200 });
          scheduleNext();
        },
      });
      return;
    }
    // A new animation on the angle replaces the one still running.
    turn = animate(wheel, {
      angle: target,
      duration: turnTime,
      ease: 'inOutQuad',
      onUpdate: render,
      onComplete: scheduleNext,
    });
    // The glow drifts to a new random spot over the same turn.
    animate(glow, {
      x: utils.random(GLOW.x[0], GLOW.x[1]),
      y: utils.random(GLOW.y[0], GLOW.y[1]),
      r: utils.random(GLOW.r[0], GLOW.r[1]),
      duration: turnTime,
      ease: 'inOutQuad',
      onUpdate: renderGlow,
    });
  }

  /** The shorter way round to step `n`. */
  const turnTo = (n: number) => {
    let by = (((n - step) % COUNT) + COUNT) % COUNT;
    if (by > COUNT / 2) by -= COUNT;
    turnBy(by, true);
  };

  // ---------- Clicks: each one stops autoplay ----------
  const onDisc = () => stopAutoplay();
  const onPrev = () => {
    stopAutoplay();
    turnBy(-1, true);
  };
  const onNext = () => {
    stopAutoplay();
    turnBy(1, true);
  };
  const onKeyword = (e: Event) => {
    stopAutoplay();
    turnTo(keywordEls.indexOf(e.currentTarget as HTMLButtonElement));
  };

  // ---------- Scroll hold ----------
  /** Distance (px) from the section to its resting place: centred in the
   *  viewport, or at the top if it is taller. */
  const offset = () => {
    const gap = Math.max(0, (scroller.clientHeight - root.offsetHeight) / 2);
    return root.getBoundingClientRect().top - scroller.getBoundingClientRect().top - gap;
  };
  const hold = (o: number) => {
    held = true;
    pending = 0;
    scroller.scrollTop += o;
    heldAt = scroller.scrollTop;
    lastOffset = 0;
    scheduleNext();
  };
  const release = (finished: boolean) => {
    held = false;
    done = finished;
    pending = 0;
    scheduleNext();
  };

  /** Scroll input while held: `dy` > 0 is down. */
  const input = (dy: number) => {
    if (performance.now() - turnStart < turnTime * SETTLE) return;
    if (Math.sign(dy) !== Math.sign(pending)) pending = 0;
    pending += dy;
    if (Math.abs(pending) < STEP_DISTANCE) return;
    const dir = pending > 0 ? 1 : -1;
    pending = 0;
    if (dir > 0 && step === LAST) release(true);
    else if (dir < 0 && step === 0) release(false);
    else turnBy(dir, true);
  };

  const onWheel = (e: WheelEvent) => {
    if (done || e.ctrlKey) return;
    const dy = e.deltaY * (e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? scroller.clientHeight : 1);
    if (!held) {
      // Coming down: stop the scroll on the section's resting place.
      const o = offset();
      if (dy <= 0 || o < -1 || o - dy > 0) return;
      e.preventDefault();
      hold(o);
      return;
    }
    e.preventDefault();
    input(dy);
  };

  // Keys, scrollbar drags and touch momentum move the scroll without wheel
  // events: crossing the resting place downwards holds there; while held,
  // small moves snap back and a big jump (a scrollbar drag) lets go.
  const onScroll = () => {
    if (done) return;
    if (held) {
      const moved = scroller.scrollTop - heldAt;
      if (Math.abs(moved) > scroller.clientHeight / 3) release(moved > 0);
      else if (moved) scroller.scrollTop = heldAt;
      return;
    }
    const o = offset();
    if (lastOffset > 0 && o <= 0 && o > -scroller.clientHeight / 3) hold(o);
    else lastOffset = o;
  };

  const onTouchStart = (e: TouchEvent) => {
    touchY = e.touches[0].clientY;
  };
  const onTouchMove = (e: TouchEvent) => {
    if (!held || done) return;
    const y = e.touches[0].clientY;
    e.preventDefault();
    input(touchY - y);
    touchY = y;
  };

  const isTyping = (el: Element | null) =>
    !!el && (el.matches('input, textarea, select, [contenteditable]') || el.closest('[contenteditable]') !== null);
  const onKey = (e: KeyboardEvent) => {
    if (!held || done || e.altKey || e.ctrlKey || e.metaKey || isTyping(document.activeElement)) return;
    // Space and Enter on a focused button press it.
    if (e.key === ' ' && document.activeElement?.matches('button')) return;
    const down = ['ArrowDown', 'PageDown', ' '].includes(e.key) && !(e.key === ' ' && e.shiftKey);
    const up = ['ArrowUp', 'PageUp'].includes(e.key) || (e.key === ' ' && e.shiftKey);
    if (!down && !up) return;
    e.preventDefault();
    pending = 0;
    input(down ? STEP_DISTANCE : -STEP_DISTANCE);
  };

  discEl.addEventListener('click', onDisc);
  prevEl.addEventListener('click', onPrev);
  nextEl.addEventListener('click', onNext);
  keywordEls.forEach((el) => el.addEventListener('click', onKeyword));
  scroller.addEventListener('wheel', onWheel, { passive: false });
  scroller.addEventListener('scroll', onScroll, { passive: true });
  scroller.addEventListener('touchstart', onTouchStart, { passive: true });
  scroller.addEventListener('touchmove', onTouchMove, { passive: false });
  document.addEventListener('keydown', onKey);
  lastOffset = offset();
  render();

  // Autoplay runs while the section is on screen, as the Process section's does.
  const io = new IntersectionObserver(
    ([entry]) => {
      visible = entry.isIntersecting;
      if (visible) scheduleNext();
      else window.clearTimeout(next);
    },
    { threshold: 0.4 },
  );
  io.observe(root);

  // Navigation is full page loads today; once view transitions are added
  // this tears the section down before the swap.
  document.addEventListener(
    'astro:before-swap',
    () => {
      io.disconnect();
      window.clearTimeout(next);
      turn?.cancel();
      utils.remove([wheel, glow, wheelEl]);
      discEl.removeEventListener('click', onDisc);
      prevEl.removeEventListener('click', onPrev);
      nextEl.removeEventListener('click', onNext);
      keywordEls.forEach((el) => el.removeEventListener('click', onKeyword));
      scroller.removeEventListener('wheel', onWheel);
      scroller.removeEventListener('scroll', onScroll);
      scroller.removeEventListener('touchstart', onTouchStart);
      scroller.removeEventListener('touchmove', onTouchMove);
      document.removeEventListener('keydown', onKey);
    },
    { once: true },
  );
</script>
