---
// Stack page 5: no framework + Anime.js v4. The Hero (learning-order step 3,
// same markup, CSS, assets, chart data and motion spec as the baseline 02)
// and the Process section (Process.astro), in landing page order. Astro
// renders the markup at build time; bundled <script>s animate it. The
// wrapper is the sandbox root and the page's scroll container; each landing
// section marks itself with data-lab-part. See notes.md.
import '@fontsource-variable/manrope';
import './Hero.css';
import Ads from './Ads.astro';
import Process from './Process.astro';
import Results from './Results.astro';
import Testimonials from './Testimonials.astro';
import { AXIS_TICKS, HIGHLIGHT_X, acos, metrics, sales, toPath } from './chartData';
import dfLogo from './assets/df-logo.png?url';
import amazonLogo from './assets/amazon-logo.svg?url';
import globe from './assets/globe.svg?url';
import chevronDown from './assets/chevron-down.svg?url';
import download from './assets/download.svg?url';
import infoCircle from './assets/info-circle.svg?url';
import phoneCall from './assets/phone-call.svg?url';

const NAV = ['Home', 'Services', 'About', 'Resources', 'Contact Us'];
---

<div class="page" data-sandbox="05-hero-vanilla-anime">
  <div class="hero" data-hero data-lab-part="Hero">
    <header class="hero__header">
      <div class="hero__brand">
        <a class="hero__logo" href="#top" aria-label="Digit Fruition home">
          <img src={dfLogo} width="108" height="37" alt="Digit Fruition" />
        </a>
        <nav class="hero__nav" aria-label="Main">
          {NAV.map((item, i) => (
            <a href="#top" class="hero__nav-item" aria-current={i === 0 ? 'page' : undefined}>{item}</a>
          ))}
        </nav>
      </div>
      <div class="hero__tools">
        <button type="button" class="hero__lang">
          <img src={globe} width="17" height="17" alt="" /> EN <img src={chevronDown} width="14" height="14" alt="" />
        </button>
        <a href="#top" class="hero__audit">
          <img src={download} width="17" height="17" alt="" /> Get a Free Audit
        </a>
      </div>
    </header>

    <section class="hero__main">
      <h1 class="hero__title">
        <img class="hero__amazon" src={amazonLogo} width="246.19" height="83.28" alt="amazon" />
        <span class="hero__title-words">
          <span class="hero__title-word">PPC</span>
          <span class="hero__title-word">Agency</span>
        </span>
      </h1>

      <p class="hero__sub">
        We help Amazon brands scale to $1M in monthly revenue with a custom ad strategy at a sustainable TACOS.
      </p>

      <a href="#top" class="hero__cta">
        <!-- Figma clips the 33.6px glyph to a 28px box, offset by -2.8px. -->
        <span class="hero__phone"><img src={phoneCall} width="33.6" height="33.6" alt="" /></span>
        Book a Discovery Call
      </a>

      <div class="hero__chart">
        <div class="hero__metrics">
          {metrics.map((m) => (
            <div class:list={['hero__metric', m.bar && `hero__metric--${m.bar}`]}>
              <span class="hero__metric-label">
                {m.label} <img src={chevronDown} width="14" height="14" alt="" />
                <img src={infoCircle} width="18" height="18" alt="" />
              </span>
              <strong class="hero__metric-value">{m.value}</strong>
            </div>
          ))}
        </div>

        <div class="hero__graph">
          <div class="hero__axis-col" aria-hidden="true">
            <div class="hero__axis hero__axis--left">
              {AXIS_TICKS.map((t) => <span style={{ '--t': t }}>€{t ? `${t}K` : 0}</span>)}
            </div>
          </div>
          <div class="hero__plot" data-plot>
            <div class="hero__guide" aria-hidden="true"></div>
            <div class="hero__plot-area">
              <div class="hero__grid" aria-hidden="true">
                {AXIS_TICKS.map((t) => <i style={{ '--t': t }}></i>)}
              </div>
              <svg
                class="hero__lines"
                viewBox="0 0 1000 250"
                preserveAspectRatio="none"
                role="img"
                aria-label="Sales and ACOS from Oct 15 to Dec 29"
              >
                <path class="hero__line--sales" d={toPath(sales)} vector-effect="non-scaling-stroke"></path>
                <path class="hero__line--acos" d={toPath(acos)} vector-effect="non-scaling-stroke"></path>
              </svg>
              <div class="hero__dot" aria-hidden="true"></div>
            </div>
          </div>
          <div class="hero__axis-col" aria-hidden="true">
            <div class="hero__axis hero__axis--right">
              {AXIS_TICKS.map((t) => <span style={{ '--t': t }}>{t}%</span>)}
            </div>
          </div>
        </div>

        <div class="hero__dates" aria-hidden="true">
          <span>Oct 15</span>
          <span style={{ '--at': HIGHLIGHT_X }}>Dec 2</span>
          <span>Dec 29</span>
        </div>
      </div>

      <button type="button" class="hero__live" aria-pressed="false">Live mode</button>

      <p class="hero__foot">
        Unlike the big guys, we only work with a select few brands, giving you the VIP treatment with laser-focused
        attention to detail.
      </p>
    </section>
  </div>

  <Ads />

  <Process />

  <Results />

  <Testimonials />
</div>

<script>
  import { animate, createScope, createTimeline, stagger, svg, utils } from 'animejs';
  import { AXIS_MAX, HIGHLIGHT_X, acos, sales, toPath, valueAt, type Point } from './chartData';

  // GSAP's powerN is Anime's Quad/Cubic/Quart/Quint (power3 = Quart).
  const EASE = 'outQuart';

  const root = document.querySelector<HTMLElement>('[data-hero]')!;
  const q = <T extends Element = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
  const plot = q('[data-plot]');
  const guide = q('.hero__guide');
  const dot = q('.hero__dot');
  const salesPath = q<SVGPathElement>('.hero__line--sales');
  const acosPath = q<SVGPathElement>('.hero__line--acos');
  const liveButton = q<HTMLButtonElement>('.hero__live');

  // Current series (live mode mutates these) and the highlight position.
  let series: { sales: Point[]; acos: Point[] } = { sales: [...sales], acos: [...acos] };
  const highlight = { x: HIGHLIGHT_X };

  const placeHighlight = () => {
    const x = highlight.x;
    const y = valueAt(series.acos, x);
    guide.style.left = `${x * 100}%`;
    dot.style.left = `${x * 100}%`;
    dot.style.top = `${(1 - y / AXIS_MAX) * 100}%`;
  };

  // Everything lives in one scope; scope.revert() kills the timeline, the
  // hover and live-mode animations, and restores inline styles.
  let stopLive = () => {};
  const scope = createScope({ root, mediaQueries: { reduce: '(prefers-reduced-motion: reduce)' } }).add((self) => {
    placeHighlight();
    if (self?.matches.reduce) return;

    const lines = svg.createDrawable([salesPath, acosPath]);
    const rise = (y: number) => ({ y: [y, 0], opacity: [0, 1] });

    // Every step's start state is set up front, so elements that start late
    // in the timeline are hidden from the first frame, as with GSAP's from().
    utils.set('.hero__logo, .hero__nav, .hero__tools > *, .hero__amazon, .hero__title-word, .hero__sub, .hero__cta, .hero__metric, .hero__axis span, .hero__dates span, .hero__live, .hero__foot', { opacity: 0 });
    utils.set(lines, { draw: '0 0' });
    guide.style.transformOrigin = 'bottom';
    utils.set(guide, { scaleY: 0 });
    utils.set(dot, { scale: 0 });

    createTimeline({ defaults: { ease: EASE } })
      .add('.hero__logo, .hero__nav, .hero__tools > *', { ...rise(-16), duration: 600, delay: stagger(80) }, 0)
      .add('.hero__amazon', { ...rise(28), duration: 800 }, 150)
      .add('.hero__title-word', { ...rise(28), duration: 800, delay: stagger(80) }, 300)
      .add('.hero__sub', { ...rise(16), duration: 700 }, 600)
      .add('.hero__cta', { ...rise(12), scale: [0.96, 1], duration: 600, ease: 'outBack(2)' }, 750)
      .add('.hero__metric', { ...rise(16), duration: 500, delay: stagger(60) }, 900)
      .add('.hero__axis span, .hero__dates span', { opacity: [0, 1], duration: 400, delay: stagger(20) }, 1000)
      .add(lines, { draw: ['0 0', '0 1'], duration: 1600, ease: 'inOutCubic', delay: stagger(150) }, 1050)
      .add('.hero__live, .hero__foot', { ...rise(12), duration: 600, delay: stagger(100) }, 2200)
      .add(guide, { scaleY: [0, 1], duration: 500 }, 2300)
      .add(dot, { scale: [0, 1], duration: 500, ease: 'outBack(3)' }, 2500);
  });

  // Reduced motion: hover and live mode jump straight to their end values
  // instead of tweening. Checked at each call, so a changed setting applies at once.
  const still = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Hover: the guide and dot follow the pointer along the ACOS line, then
  // settle back on Dec 2. `composition: 'replace'` lets each new animation
  // take over the running one.
  const follow = (x: number, duration: number) =>
    animate(highlight, { x, duration: still() ? 0 : duration, ease: EASE, composition: 'replace', onUpdate: placeHighlight });
  const onMove = (e: PointerEvent) => {
    const r = plot.getBoundingClientRect();
    follow(utils.clamp((e.clientX - r.left) / r.width, 0, 1), 350);
  };
  const onLeave = () => follow(HIGHLIGHT_X, 600);
  plot.addEventListener('pointermove', onMove);
  plot.addEventListener('pointerleave', onLeave);

  // Live mode: every tick the lines drift toward a new noisy version of the
  // traced data. The interval and animation die on toggle-off and on leave.
  const jitter = (base: Point[], amount: number): Point[] =>
    base.map(([x, y]) => [x, Math.max(0, y + utils.random(-amount, amount, 2))]);

  const startLive = () => {
    let anim: ReturnType<typeof animate> | undefined;
    const tick = () => {
      const from = series;
      const to = { sales: jitter(sales, 2.5), acos: jitter(acos, 1.5) };
      const mix = { t: 0 };
      const lerp = (a: Point[], b: Point[]) => a.map(([x, y], i): Point => [x, y + (b[i][1] - y) * mix.t]);
      anim = animate(mix, {
        t: 1,
        duration: still() ? 0 : 1100,
        ease: 'inOutSine',
        onUpdate: () => {
          series = { sales: lerp(from.sales, to.sales), acos: lerp(from.acos, to.acos) };
          salesPath.setAttribute('d', toPath(series.sales));
          acosPath.setAttribute('d', toPath(series.acos));
          placeHighlight();
        },
      });
    };
    tick();
    const id = window.setInterval(tick, 1400);
    stopLive = () => {
      window.clearInterval(id);
      anim?.cancel();
      stopLive = () => {};
    };
  };

  const onToggle = () => {
    const on = liveButton.getAttribute('aria-pressed') !== 'true';
    liveButton.setAttribute('aria-pressed', String(on));
    liveButton.textContent = on ? 'Stop live mode' : 'Live mode';
    if (on) startLive();
    else stopLive();
  };
  liveButton.addEventListener('click', onToggle);

  // Navigation is full page loads today; once view transitions are added
  // this tears the section down before the swap.
  document.addEventListener(
    'astro:before-swap',
    () => {
      stopLive();
      scope.revert();
      utils.remove(highlight);
      plot.removeEventListener('pointermove', onMove);
      plot.removeEventListener('pointerleave', onLeave);
      liveButton.removeEventListener('click', onToggle);
    },
    { once: true },
  );
</script>
