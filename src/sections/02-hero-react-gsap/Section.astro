---
// Stack page 2: React islands + GSAP. The Hero (learning-order step 2) and
// the Process section (docs/briefs/process/brief.md), in landing page order.
// The wrapper is the sandbox root and the page's scroll container; each
// landing section marks itself with data-lab-part. Case studies is the
// shared static piece from src/components/ (no island). See notes.md.
import '@fontsource-variable/manrope';
import Hero from './Hero';
import Ads from './Ads';
import Process from './Process';
import Results from './Results';
import Audits from '../../components/audits/Audits.astro';
import AboutUs from '../../components/about/AboutUs.astro';
import CaseStudies from '../../components/case-studies/CaseStudies.astro';
import FormFaq from '../../components/forms/FormFaq.astro';
import Logo from '../../components/logo/Logo.astro';
import Footer from '../../components/footer/Footer.astro';
---

<div class="page" data-sandbox="02-hero-react-gsap">
  <Hero client:load />
  <Ads client:load />
  <Audits />
  <Process client:load />
  <AboutUs />
  <Results client:visible={{ rootMargin: '100%' }} />
  <CaseStudies />
  <FormFaq />
  <Logo />
  <Footer />
</div>
