---
// The landing page's section order (docs/site-structure.md) as plain blocks
// in one scroll container. Each block carries data-lab-part, so the info
// bar's section tag follows the scroll. Real sections replace the blocks as
// they are built.
const PARTS = [
  'Hero',
  'Ads',
  'Audits',
  'Process',
  'About us',
  'Results',
  'Case studies',
  'Testimonials',
  'Form',
  'Logo',
  'Footer',
];
// Logo strip and footer are short on the real page; the rest fill a screen.
const SHORT = new Set(['Logo', 'Footer']);
---

<div class="skeleton">
  {PARTS.map((name, i) => (
    <section class:list={['skeleton__part', SHORT.has(name) && 'skeleton__part--short']} data-lab-part={name}>
      <span class="skeleton__index">{String(i + 1).padStart(2, '0')}</span>
      <h2>{name}</h2>
    </section>
  ))}
</div>

<style>
  .skeleton {
    height: 100%;
    overflow-y: auto;
  }
  .skeleton__part {
    min-height: 100%;
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-16) var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }
  .skeleton__part:nth-child(even) {
    background: var(--color-surface);
  }
  .skeleton__part--short {
    min-height: auto;
  }
  .skeleton__index {
    font: var(--text-sm) / 1 var(--font-mono);
    color: var(--color-accent);
  }
  h2 {
    margin: 0;
    font-size: var(--text-display);
    line-height: var(--leading-tight);
    font-weight: var(--weight-bold);
  }
</style>
