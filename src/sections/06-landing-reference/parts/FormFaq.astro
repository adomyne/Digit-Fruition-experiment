---
// Form & FAQ: the free audit request form beside the FAQ list.
// Figma: Quick answers FAQ 142:1606 (1440 x 627). Figma sets the form in
// Arimo and the buttons in Neue Montreal; this build uses Manrope for both
// (open question in the project, see notes.md).
import selectChevron from '../assets/select-chevron.svg?url';
import shieldCheck from '../assets/shield-check.svg?url';
import download from '../assets/download.svg?url';
import phoneCall from '../assets/phone-call-sm.svg?url';

type Field = { id: string; label: string; placeholder: string; type?: 'text' | 'email' | 'tel'; options?: string[] };

const rows: Field[][] = [
  [
    { id: 'name', label: 'Name *', placeholder: 'First and last name', type: 'text' },
    { id: 'email', label: 'Email *', placeholder: 'you@company.com', type: 'email' },
  ],
  [
    { id: 'phone', label: 'Phone *', placeholder: '(555) 000-0000', type: 'tel' },
    { id: 'revenue', label: 'Monthly revenue *', placeholder: 'Select a range', options: ['Under $10K', '$10K–$50K', '$50K–$250K', '$250K+'] },
  ],
  [
    { id: 'service', label: 'Service needed *', placeholder: 'Choose a service', options: ['PPC management', 'PPC audit', 'Listing optimization'] },
    { id: 'time', label: 'Best time to call *', placeholder: 'Choose a time', options: ['Morning', 'Afternoon', 'Evening'] },
  ],
];

const questions = [
  'What Is Amazon PPC?',
  'How does CPC or PPC advertising work?',
  'What is CPM (cost per thousand impressions) advertising, and how do I use it?',
  'What is display advertising?',
  'How does Amazon Ads Work?',
];
---

<section class="form-faq" data-lab-part="Form & FAQ">
  <div class="layout">
    <form class="form" action="#" onsubmit="return false">
      <h2 class="form__title">Your Free Audit Report</h2>
      <div class="fields">
        {rows.map((row) => (
          <div class="fields__row">
            {row.map((f) => (
              <div class="field">
                <label class="field__label" for={`ref-${f.id}`}>{f.label}</label>
                {f.options ? (
                  <div class="field__select">
                    <select class="field__input" id={`ref-${f.id}`} name={f.id} required>
                      <option value="" selected disabled>{f.placeholder}</option>
                      {f.options.map((o) => <option>{o}</option>)}
                    </select>
                    <img class="field__chevron" src={selectChevron} alt="" />
                  </div>
                ) : (
                  <input class="field__input" id={`ref-${f.id}`} name={f.id} type={f.type} placeholder={f.placeholder} required />
                )}
              </div>
            ))}
          </div>
        ))}
      </div>
      <div class="privacy">
        <span class="privacy__icon"><img src={shieldCheck} alt="" /></span>
        <p class="privacy__text">
          By submitting, you agree to our Privacy Policy and to receive relevant emails and calls from DigitFruition. No spam — unsubscribe anytime.
        </p>
      </div>
      <button class="button button--accent" type="submit">
        <img class="button__icon" src={download} alt="" />
        <span>Get a Free Audit</span>
      </button>
    </form>

    <div class="faq">
      <div class="faq__section">
        <h2 class="faq__title">Frequently Asked Questions</h2>
        <ul class="faq__list">
          {questions.map((q) => (
            <li class="question">
              <button class="question__button" type="button" aria-expanded="false">
                <span class="question__text">{q}</span>
                <span class="question__plus" aria-hidden="true"></span>
              </button>
            </li>
          ))}
        </ul>
      </div>
      <a class="button button--ink" href="#">
        <span class="button__phone"><img src={phoneCall} alt="" /></span>
        <span>Book a Discovery Call</span>
      </a>
    </div>
  </div>
</section>

<style>
  .form-faq {
    box-sizing: border-box;
    height: 39.1875rem; /* 627px: Figma clips the frame's 140px bottom padding */
    padding: var(--space-20) var(--space-5) 0 0;
    overflow: hidden;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-sans);
    font-weight: var(--weight-regular);
  }
  .form-faq *, .form-faq *::before, .form-faq *::after { box-sizing: border-box; }
  p, h2, ul { margin: 0; }
  ul { padding: 0; list-style: none; }
  img { display: block; }
  a { color: inherit; text-decoration: none; }

  .layout {
    display: flex;
    justify-content: center;
    gap: var(--space-20);
    width: 88.75rem; /* 1420px */
    margin-inline: auto;
  }

  /* Form */
  .form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    width: 45.5rem; /* 728px */
    margin: 0;
    padding: var(--space-7) var(--space-5) var(--space-6);
  }
  .form__title {
    width: 27.5rem; /* 440px */
    font-size: var(--text-h3);
    font-weight: var(--weight-regular);
    line-height: var(--leading-heading);
    color: var(--color-accent);
  }
  .fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-3-5);
  }
  .fields__row {
    display: flex;
    gap: var(--space-3-5);
  }
  .field {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-1-5);
    min-width: 0;
  }
  /* White on white, as in Figma (open question in the project). */
  .field__label {
    font-size: var(--text-small);
    font-weight: var(--weight-bold);
    line-height: var(--leading-heading);
    color: var(--color-on-ink);
  }
  .field__select { position: relative; }
  .field__input {
    width: 100%;
    height: var(--control-height-lg);
    padding: 0 var(--space-3-5);
    border: 1px solid var(--color-axis);
    border-radius: var(--radius-input);
    background: var(--color-bg);
    color: var(--color-text);
    font: var(--weight-regular) var(--text-input) / var(--leading-button) var(--font-sans);
    text-overflow: ellipsis;
    appearance: none;
  }
  .field__input::placeholder { color: var(--color-axis); opacity: 1; }
  select.field__input { padding-right: var(--space-10); }
  select.field__input:invalid { color: var(--color-axis); }
  .field__chevron {
    position: absolute;
    top: 50%;
    right: var(--space-3-5);
    width: var(--space-4);
    height: var(--space-4);
    transform: translateY(-50%);
    pointer-events: none;
  }
  .field__input:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 1px; }

  .privacy {
    display: flex;
    align-items: center;
    gap: var(--space-2-5);
  }
  .privacy__icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 1.625rem; /* 26px */
    height: 1.625rem;
    border-radius: var(--radius-full);
    background: var(--color-accent);
  }
  .privacy__icon img { width: var(--space-3-5); height: var(--space-3-5); }
  .privacy__text {
    flex: 1;
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--color-gray);
  }

  .button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    height: var(--control-height);
    padding: 0 var(--space-5);
    border: 0;
    border-radius: var(--radius-sm);
    color: var(--color-on-accent);
    font: var(--weight-medium) var(--text-button-sm) / normal var(--font-sans);
    white-space: nowrap;
    cursor: pointer;
  }
  .button--accent { width: 100%; background: var(--color-accent); }
  .button--ink { width: 31.4375rem; /* 503px */ background: var(--color-ink); }
  .button__icon { width: var(--icon-sm); height: var(--icon-sm); }
  .button__phone {
    position: relative;
    width: var(--space-5);
    height: var(--space-5);
    overflow: hidden;
  }
  .button__phone img {
    position: absolute;
    top: calc(var(--space-2) / -4);
    left: calc(var(--space-2) / -4);
    width: var(--icon-md);
    height: var(--icon-md);
  }
  .button:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }

  /* FAQ */
  .faq {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-7) 0 var(--space-6);
  }
  .faq__section {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    gap: 2.6875rem; /* 43px */
    width: 100%;
  }
  .faq__title {
    font-size: var(--text-h4);
    font-weight: var(--weight-regular);
    line-height: var(--leading-heading);
    color: var(--color-ink);
    text-align: center;
  }
  .faq__list {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    width: 31.4375rem; /* 503px */
    padding-bottom: var(--space-10);
  }
  .question {
    height: 2.8202rem; /* 45.12px */
    border-top: 0.564px dashed var(--color-gray);
  }
  .question__button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-ink);
    font: var(--weight-regular) var(--text-base) / var(--leading-body) var(--font-sans);
    text-align: left;
    cursor: pointer;
  }
  .question__text { max-width: 26.7088rem; /* 427.34px */ }
  /* Plus sign: two 1.13px strokes, 20.3px long, in a 22.56px box. */
  .question__plus {
    position: relative;
    flex-shrink: 0;
    width: 1.4101rem;
    height: 1.4101rem;
  }
  .question__plus::before, .question__plus::after {
    content: '';
    position: absolute;
    background: var(--color-ink);
  }
  .question__plus::before { top: 0.0706rem; left: 0.67rem; width: 0.0705rem; height: 1.2691rem; }
  .question__plus::after { top: 0.67rem; left: 0.0706rem; width: 1.2691rem; height: 0.0705rem; }
  .question__button:hover { color: var(--color-accent); }
  .question__button:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
</style>
