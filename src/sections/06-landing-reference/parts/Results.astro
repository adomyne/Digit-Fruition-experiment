---
// Results: the heading over a pile of currency tokens, then the impact
// numbers poster. Figma: Results Section 142:1466 (1440 x 826.5) and
// Field-tested impact poster 142:1469 (1440 x 1000).
import currency from '../assets/currency-symbols.webp?url';
import coin from '../assets/value-communication.webp?url';
import download from '../assets/download.svg?url';

const impact = [
  { value: '56%', label: 'Growth in Monthly Sales' },
  { value: '$30K', label: 'New Monthly Revenue' },
  { value: '2X', label: 'Growth in Monthly Revenue' },
  { value: '43%', label: 'Improvement in CTR' },
];
---

<section class="results" data-lab-part="Results">
  <div class="pile">
    <h2 class="pile__title">Results That Speak For Themselves</h2>
    <img class="pile__image" src={currency} alt="A pile of orange euro and percent tokens" loading="lazy" decoding="async" />
  </div>

  <div class="poster">
    <div class="poster__frame">
      <img class="poster__coin" src={coin} alt="" loading="lazy" decoding="async" />
      <div class="impact">
        <dl class="impact__list">
          {impact.map((row) => (
            <div class="impact__row">
              <dt class="impact__value">{row.value}</dt>
              <dd class="impact__label">{row.label}</dd>
            </div>
          ))}
        </dl>
        <div class="impact__footer">
          <p class="impact__note">For 5-6 Figure US/EU brands</p>
          <a class="button" href="#">
            <img class="button__icon" src={download} alt="" />
            <span>Get a Free Audit</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .results {
    box-sizing: border-box;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-sans);
    font-weight: var(--weight-regular);
  }
  .results *, .results *::before, .results *::after { box-sizing: border-box; }
  p, h2, dl, dd { margin: 0; }
  img { display: block; }
  a { color: inherit; text-decoration: none; }

  .pile {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: var(--space-16);
  }
  .pile__title {
    font-size: var(--text-h3);
    font-weight: var(--weight-regular);
    line-height: var(--leading-heading);
    white-space: nowrap;
  }
  .pile__image {
    width: 100%;
    min-width: var(--width-page);
    height: 44.8418rem; /* 717.47px */
    object-fit: cover;
  }

  .poster { overflow: hidden; }
  .poster__frame {
    position: relative;
    width: var(--width-page);
    height: 62.5rem; /* 1000px */
    margin-inline: auto;
  }
  .poster__coin {
    position: absolute;
    top: -5.7692rem; /* -92.31px */
    left: 50.5725rem; /* 809.16px */
    width: 66.5861rem; /* 1065.38px */
    height: 62.3584rem; /* 997.73px */
    max-width: none;
    object-fit: cover;
    opacity: 0.1;
  }
  .impact {
    position: absolute;
    top: 8.5894rem; /* 137.43px */
    left: 12.4174rem; /* 198.68px */
    display: flex;
    flex-direction: column;
    gap: 2.5625rem; /* 41px */
    width: 65.3326rem; /* 1045.32px */
  }
  .impact__list {
    display: flex;
    flex-direction: column;
    height: 43.5625rem; /* 697px */
  }
  /* First row 127px tall, the rest 190px; numbers sit 26px above the rule. */
  .impact__row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    height: 11.875rem; /* 190px */
    padding-bottom: 1.625rem; /* 26px */
    border-bottom: 1px solid var(--color-accent-rule);
  }
  .impact__row:first-child { height: 7.9375rem; /* 127px */ }
  .impact__value {
    font-size: var(--text-h2);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-h2);
    letter-spacing: var(--tracking-half);
    color: var(--color-accent);
    white-space: nowrap;
  }
  .impact__label {
    width: 15.75rem; /* 252px */
    font-size: var(--text-h4);
    line-height: var(--leading-heading);
  }
  .impact__footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }
  .impact__note {
    width: var(--width-main);
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--color-accent);
  }
  .button {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    height: var(--control-height);
    padding: 0 var(--space-5);
    border-radius: var(--radius-sm);
    background: var(--color-ink);
    color: var(--color-on-ink);
    font-size: var(--text-base);
    line-height: var(--leading-body);
    white-space: nowrap;
  }
  .button__icon { width: var(--icon-sm); height: var(--icon-sm); }
  .button:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
</style>
