---
// Testimonials: a video testimonial card with the quote, and the next video
// peeking in faded on the right. Figma: Testimonials 142:1589 (1440 x 681.7).
import video from '../assets/testimonial-video.webp?url';
import ellingtonLogo from '../assets/logo-ellington.webp?url';
---

<section class="testimonials" data-lab-part="Testimonials">
  <h2 class="title">Testimonials</h2>
  <div class="carousel" data-lab-noswipe>
    <article class="slide">
      <div class="video">
        <img class="video__still video__still--main" src={video} alt="Jamal, founder of Ellington Pens, in a video testimonial" loading="lazy" decoding="async" />
        <p class="video__caption">We've been working for the last 8 months</p>
      </div>
      <div class="details">
        <blockquote class="quote">
          “We’ve been working with DigitFruition for 8 months, and they’ve transformed our entire PPC strategy. Our monthly revenue went from $70K to $195K, profit nearly tripled and our TACOS has come down. Nojus isn’t just clicking buttons — he’s a strategist, and that’s rare to find.”
        </blockquote>
        <div class="byline">
          <div class="byline__who">
            <p class="byline__name">Jamal</p>
            <p class="byline__role">Founder - Ellington Pens</p>
          </div>
          <div class="byline__logo">
            <img class="byline__logo-image" src={ellingtonLogo} alt="Ellington Pens" loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
    </article>
    <div class="video video--next" aria-hidden="true">
      <img class="video__still video__still--next" src={video} alt="" loading="lazy" decoding="async" />
    </div>
  </div>
</section>

<style>
  .testimonials {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-12);
    padding: var(--space-16) 0 var(--space-20);
    overflow: hidden;
    background: var(--color-accent);
    color: var(--color-text);
    font-family: var(--font-sans);
    font-weight: var(--weight-regular);
  }
  .testimonials *, .testimonials *::before, .testimonials *::after { box-sizing: border-box; }
  p, h2, blockquote { margin: 0; }
  img { display: block; }

  .title {
    width: 37.9502rem; /* 607.2px */
    font-size: var(--text-h2-alt);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-h2); /* 57.15 / 44.65 */
    letter-spacing: var(--tracking-wide);
    text-align: center;
  }
  .carousel {
    display: flex;
    align-items: flex-start;
    gap: var(--space-50);
    width: 100%;
    min-width: var(--width-page);
    padding-left: var(--space-50);
  }
  .slide {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 1.1162rem; /* 17.86px */
    width: 54.125rem; /* 866px */
    background: linear-gradient(to bottom, var(--color-bg) 50.921%, var(--color-accent) 77.294%);
  }
  .video {
    position: relative;
    flex-shrink: 0;
    width: 20.8867rem; /* 334.19px */
    height: 26.9811rem; /* 431.7px */
    overflow: hidden;
  }
  .video--next {
    width: 20.9475rem; /* 335.16px */
    opacity: 0.2;
  }
  /* Figma crops the still: full width, about 140% tall, shifted up. */
  .video__still {
    position: absolute;
    left: 0;
    width: 100%;
    max-width: none;
  }
  .video__still--main { top: -29.62%; height: 140.3%; }
  .video__still--next { top: -29.33%; height: 138.89%; }
  .video__caption {
    position: absolute;
    top: 22.86rem; /* 365.76px */
    left: 2.72rem; /* 43.52px */
    width: 15.5664rem; /* 249.06px */
    font-size: var(--text-caption-lg);
    line-height: var(--leading-heading);
    color: var(--color-on-accent);
    text-align: center;
  }
  .details {
    display: flex;
    flex-direction: column;
    align-self: stretch;
    justify-content: space-between;
    width: 32.3125rem; /* 517px */
    padding: var(--space-6) 0;
  }
  .quote {
    padding: 0 var(--space-12) 0 var(--space-6);
    font-size: var(--text-base);
    line-height: var(--leading-body);
    text-align: center;
  }
  .byline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--space-6);
  }
  .byline__who {
    display: flex;
    flex-direction: column;
    gap: var(--space-2-5);
    text-align: center;
  }
  .byline__name {
    font-size: var(--text-h4);
    font-weight: var(--weight-bold);
    line-height: var(--leading-heading);
  }
  .byline__role {
    font-size: var(--text-base);
    line-height: var(--leading-body);
  }
  /* Figma crops the logo PNG inside a 102 x 68 box. */
  .byline__logo {
    position: relative;
    width: 6.3766rem; /* 102.03px */
    height: 4.25rem; /* 68px */
    overflow: hidden;
  }
  .byline__logo-image {
    position: absolute;
    top: -12.3%;
    left: -19.2%;
    width: 138.4%;
    height: 124.59%;
    max-width: none;
  }
</style>
