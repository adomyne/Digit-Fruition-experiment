---
// Audits: "We Also Do Audits", audit sheet preview and what the audit covers.
// Figma: Audit Section 142:1233 (1440 x 910.6).
import auditPreview from '../assets/audit-preview.webp?url';
import menuSearch from '../assets/menu-search.svg?url';
import download from '../assets/audit-download.svg?url';
import arrowRight from '../assets/arrow-right.svg?url';

const offers = [
  'Ad Type Performance Check',
  'Match Type Efficiency View',
  'TACOS Scaling Calculator',
  'Search Term ROI Breakdown',
  'Smart Budget Allocation Plan',
];
---

<section class="audits" data-lab-part="Audits">
  <header class="heading">
    <p class="heading__eyebrow">We Also Do Audits</p>
    <h2 class="heading__title">A PPC Audit Built for Revenue Growth — Not Surface-Level Insights</h2>
  </header>

  <div class="preview">
    <div class="preview__row">
      <img
        class="preview__image"
        src={auditPreview}
        alt="Sample PPC audit sheet with spend, sales, ACOS and match type tables"
        loading="lazy"
        decoding="async"
      />
      <div class="offers">
        <p class="offers__title"><span>What we offer</span></p>
        <ul class="offers__list">
          {offers.map((item) => (
            <li class="offer">
              <img class="offer__icon" src={menuSearch} alt="" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="actions">
      <a class="button button--light" href="#">
        <img class="button__icon" src={download} alt="" />
        <span>Get a Free Audit</span>
      </a>
      <a class="button button--dark" href="#">
        <span>Learn more</span>
        <img class="button__icon" src={arrowRight} alt="" />
      </a>
    </div>
  </div>
</section>

<style>
  .audits {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-12);
    padding: var(--space-16) 0 var(--space-20);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-family: var(--font-sans);
    font-weight: var(--weight-regular);
  }
  .audits *, .audits *::before, .audits *::after { box-sizing: border-box; }
  p, h2, ul { margin: 0; }
  ul { padding: 0; list-style: none; }
  a { color: inherit; text-decoration: none; }

  .heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
  }
  .heading__eyebrow {
    width: 51.3576rem; /* 821.7px */
    font-size: var(--text-md);
    font-weight: var(--weight-bold);
    line-height: var(--leading-heading);
  }
  .heading__title {
    width: 42.5rem; /* 680px */
    font-size: var(--text-h3);
    font-weight: var(--weight-regular);
    line-height: var(--leading-heading);
  }

  .preview {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    width: var(--width-content);
  }
  .preview__row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-5);
  }
  .preview__image {
    display: block;
    flex-shrink: 0;
    width: var(--width-main);
    height: 32.7219rem; /* 523.55px */
    object-fit: cover;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-elevation-3);
  }
  .offers {
    display: flex;
    flex-direction: column;
    align-items: center;
    align-self: stretch;
    width: var(--width-side);
    padding: 2.125rem 0 var(--space-6); /* 34px top */
    border: 1px solid var(--color-on-ink);
    border-radius: var(--radius-sm);
    background: linear-gradient(to bottom, var(--color-axis), var(--color-ink));
  }
  .offers__title {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 17.875rem; /* 286px */
    height: 5.25rem; /* 84px */
    font-size: var(--text-h4);
    line-height: var(--leading-heading);
  }
  .offers__title span { width: 15.0625rem; /* 241px text box */ }
  /* Title at the top, list at the bottom (Figma: justify-between). */
  .offers__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: 17.875rem;
    height: 21.1875rem; /* 339px */
    margin-top: auto;
  }
  .offer {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    height: var(--control-height);
    padding: 0 var(--space-5);
    font-size: var(--text-base);
    line-height: var(--leading-body);
    white-space: nowrap;
  }
  .offer__icon { width: var(--icon-md); height: var(--icon-md); }

  .actions {
    display: flex;
    gap: var(--space-5);
  }
  .button {
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--control-height);
    padding: 0 var(--space-5);
    border-radius: var(--radius-sm);
    font-size: var(--text-base);
    line-height: var(--leading-body);
    white-space: nowrap;
  }
  .button--light {
    flex: 1;
    gap: var(--space-2);
    background: var(--color-bg);
    box-shadow: var(--shadow-elevation-3);
    color: var(--color-text);
  }
  .button--dark {
    gap: var(--space-3);
    width: var(--width-side);
    border: 1px solid var(--color-on-ink);
    background: linear-gradient(to right, var(--color-ink), var(--color-axis));
    font-weight: var(--weight-bold);
  }
  .button__icon { display: block; width: var(--icon-sm); height: var(--icon-sm); }
  .button:focus-visible { outline: 2px solid var(--color-on-accent); outline-offset: 2px; }
</style>
