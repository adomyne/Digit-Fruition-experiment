---
// Ads: "We Handle All Amazon Ads Campaigns", one service on a glowing arc.
// Figma: Services Section 142:1216 (1440 x 831). The arc, number and copy
// are placed absolutely in the 1440 frame, as Figma has them.
import arc from '../assets/ads-arc.svg?url';
import line from '../assets/ads-line.svg?url';
import ring from '../assets/ads-number-ring.svg?url';
---

<section class="ads" data-lab-part="Ads">
  <div class="ads__frame">
    <header class="heading">
      <h2 class="heading__title">We Handle All Amazon Ads Campaigns</h2>
      <p class="heading__subtitle">A Clear Plan of Action - Not Just Insights</p>
    </header>

    <img class="arc" src={arc} alt="" />
    <img class="line" src={line} alt="" />
    <img class="ring" src={ring} alt="" />
    <p class="number">3</p>

    <div class="service">
      <h3 class="service__title">Streaming TV</h3>
      <p class="service__copy">
        This campaign integrates your brand into premium content on platforms like Prime Video and IMDb TV via Amazon Fire TV.
      </p>
      <p class="service__copy">
        Streaming TV ads are full-<br />screen, non-skippable, and highly engaging,<br />ensuring your message stands out.
      </p>
    </div>
  </div>
</section>

<style>
  .ads {
    box-sizing: border-box;
    overflow: hidden;
    background: linear-gradient(to bottom, var(--color-text), var(--color-ink));
    color: var(--color-on-ink);
    font-family: var(--font-sans);
    font-weight: var(--weight-regular);
  }
  .ads *, .ads *::before, .ads *::after { box-sizing: border-box; }
  p, h2, h3 { margin: 0; }
  img { display: block; }

  .ads__frame {
    position: relative;
    width: var(--width-page);
    height: 51.9375rem; /* 831px */
    margin-inline: auto;
  }
  .heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-20) 0 var(--space-10);
    text-align: center;
    white-space: nowrap;
  }
  .heading__title {
    font-size: var(--text-h2);
    font-weight: var(--weight-regular);
    line-height: var(--leading-h2);
    letter-spacing: var(--tracking-wide);
  }
  .heading__subtitle {
    font-size: var(--text-h3);
    font-weight: var(--weight-bold);
    line-height: var(--leading-heading);
    color: var(--color-accent);
  }

  .arc, .line, .ring, .number, .service { position: absolute; }
  .arc {
    left: 11.0625rem; /* 177px */
    top: 26.9681rem; /* 431.49px */
    width: 66.8577rem; /* 1069.72px */
    height: 66.8577rem;
  }
  /* A 49px horizontal hairline turned upright, centred on x 720. */
  .line {
    left: 43.4583rem; /* 695.33px */
    top: 29.8562rem; /* 477.7px */
    width: 3.0833rem; /* 49.33px */
    height: 1px;
    transform: rotate(90deg);
  }
  .ring {
    left: 42.3906rem; /* 678.25px */
    top: 20.875rem; /* 334px */
    width: 5.2185rem; /* 83.5px */
    height: 5.2185rem;
  }
  .number {
    left: 41.4469rem; /* 663.15px */
    top: 21.4125rem; /* 342.6px */
    width: 7.1061rem; /* 113.7px */
    font-size: var(--text-h2);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-h2);
    letter-spacing: var(--tracking-half);
    text-align: center;
  }
  .service {
    left: 34.5625rem; /* 553px */
    top: 32.8063rem; /* 524.9px */
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    width: 20.9375rem; /* 335px */
    text-align: center;
  }
  .service__title {
    font-size: var(--text-h3);
    font-weight: var(--weight-bold);
    line-height: var(--leading-heading);
  }
  /* Figma's copy is one text box with an empty 24px line between the
     paragraphs; the flex gap stands in for it. */
  .service__copy {
    font-size: var(--text-base);
    line-height: var(--leading-body);
  }
</style>
