---
// Process: "The Process" card with the mango tree, a 4-step timeline and the
// active step's copy. Figma: Process Section 142:1274 (1440 x 903.2).
import mangoTree from '../assets/mango-tree.svg?url';
import stepRing from '../assets/step-ring.svg?url';
import stepActive from '../assets/step-dot-active.svg?url';

// Figma x offsets of the four step circles inside the timeline.
const steps = [
  { n: 1, x: 0, active: true },
  { n: 2, x: 9.3838 }, /* 150.14px */
  { n: 3, x: 18.7194 }, /* 299.51px */
  { n: 4, x: 27.8606 }, /* 445.77px */
];
---

<section class="process" data-lab-part="Process">
  <div class="card">
    <h2 class="card__title">The Process</h2>
    <div class="steps">
      <div class="illustration">
        <div class="graphic">
          <img class="graphic__tree" src={mangoTree} alt="A mango tree growing from a seed" />
        </div>
        <ol class="timeline">
          {steps.map((s) => (
            <li
              class:list={['step', s.active && 'step--active']}
              style={`left: ${s.x}rem`}
              aria-current={s.active ? 'step' : undefined}
            >
              <img class="step__circle" src={s.active ? stepActive : stepRing} alt="" />
              <span class="step__number">{s.n}</span>
            </li>
          ))}
        </ol>
      </div>
      <div class="details">
        <h3 class="details__title">Listing Optimization</h3>
        <div class="details__body">
          <p class="details__summary">
            Before starting advertising, we need to make sure that your listing is phenomenal and dialed in every area.
          </p>
          <a class="details__more" href="#">Read more</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .process {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-bottom: var(--space-24);
    background: var(--color-accent);
    color: var(--color-on-ink);
    font-family: var(--font-sans);
    font-weight: var(--weight-regular);
  }
  .process *, .process *::before, .process *::after { box-sizing: border-box; }
  p, h2, h3, ol { margin: 0; }
  ol { padding: 0; list-style: none; }
  img { display: block; }

  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-12);
    width: 66.625rem; /* 1066px */
    padding: var(--space-14) 0;
    border: 1px solid var(--color-on-ink);
    border-radius: var(--radius-panel);
    background: var(--color-ink);
    box-shadow: var(--shadow-panel);
  }
  .card__title {
    font-size: var(--text-h3);
    font-weight: var(--weight-regular);
    line-height: var(--leading-heading);
    white-space: nowrap;
  }
  .steps {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
  }
  .illustration {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-12);
    padding-inline: var(--space-2-5);
  }
  .graphic {
    position: relative;
    width: 42.875rem; /* 686px */
    height: 20rem; /* 320px */
  }
  .graphic__tree {
    position: absolute;
    top: 0;
    left: 12.7513rem; /* 204.02px */
    width: 17.3375rem; /* 277.4px */
    height: 20.006rem; /* 320.1px */
  }

  /* Timeline: a white bar behind four 48px circles. */
  .timeline {
    position: relative;
    width: 30.875rem; /* 494px */
    height: 3.0146rem; /* 48.23px */
  }
  .timeline::before {
    content: '';
    position: absolute;
    top: 1.2794rem; /* 20.47px */
    left: 1.08rem; /* 17.28px */
    width: 29.4798rem; /* 471.68px */
    height: 0.3601rem; /* 5.76px */
    background: var(--color-on-ink);
  }
  .step {
    position: absolute;
    top: 0;
    width: 3.0146rem;
    height: 3.0146rem;
  }
  .step__circle { width: 100%; height: 100%; }
  .step__number {
    position: absolute;
    top: 0.66rem; /* 10.56px */
    left: 0;
    width: 100%;
    font-size: var(--text-step);
    font-weight: var(--weight-medium);
    line-height: var(--leading-heading);
    text-align: center;
  }
  .step--active .step__number {
    font-weight: var(--weight-bold);
    color: var(--color-text);
  }

  .details {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }
  .details__title {
    font-size: var(--text-h4);
    font-weight: var(--weight-bold);
    line-height: var(--leading-heading);
    white-space: nowrap;
  }
  .details__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-base);
    line-height: var(--leading-body);
    text-align: center;
  }
  /* Figma's text box ends with an empty line (24px). */
  .details__summary {
    width: 31.875rem; /* 510px */
    padding-bottom: var(--space-6);
  }
  .details__more {
    color: inherit;
    text-decoration: underline;
    text-underline-position: from-font;
    white-space: nowrap;
  }
  .details__more:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
</style>
